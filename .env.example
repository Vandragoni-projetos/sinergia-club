# GatewayPro / SinergIA - Variáveis de ambiente
# Copie este arquivo para .env e preencha com os dados do seu servidor (Hostinger, etc.)
# NUNCA commite o arquivo .env no Git.

# -----------------------------------------------------------------------------
# Banco de dados (painel "Bancos de Dados" ou equivalente)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=seu_usuario_banco
DB_PASS=sua_senha_banco
DB_NAME=nome_do_banco

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Fuso horário (PHP)
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Opcional: API / Autenticação
# -----------------------------------------------------------------------------
TOKEN_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Painel master / primeiro acesso
# Sem uma chave de licença no banco, o login de admin/infoprodutor redireciona
# para /ativacao — EXCETO se GATEWAYPRO_MASTER_SECRET estiver preenchido aqui.
# Para uma instalação nova, defina um valor longo e aleatório (não commitar .env).
# -----------------------------------------------------------------------------
GATEWAYPRO_MASTER_SECRET=

# -----------------------------------------------------------------------------
# Servidor de licenças (ativação remota)
# Basic Auth no webhook. Sem estes valores, /ativacao não valida chave remota.
# Deixe vazio em instalações que usam só GATEWAYPRO_MASTER_SECRET (primeiro acesso).
# NUNCA cole credenciais reais neste arquivo de exemplo.
# -----------------------------------------------------------------------------
LICENSE_WEBHOOK_URL=
LICENSE_WEBHOOK_USER=
LICENSE_WEBHOOK_PASS=
